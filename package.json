{
  "name": "dsh-plugin-threejs-workbench",
  "description": "Three.js workbench for DeepSeek Harness: live scene preview (iframe + import map, works offline via bundled three) and a project inspector \u2014 three revision, WebGL/WebGPU usage, removed/renamed APIs, GLB/GLTF asset weights",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "external": [
        "@deepseek-ai/dsh-client-runtime/client"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/Elmeis/dsh-plugin-threejs-workbench#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elmeis/dsh-plugin-threejs-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/Elmeis/dsh-plugin-threejs-workbench/issues"
  }
}
